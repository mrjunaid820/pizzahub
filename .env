# Pizza Hub Configuration
PORT=3000
NODE_ENV=development

# Admin Authentication
JWT_SECRET=pizzahub_super_secure_jwt_token_key_987654321_2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Restaurant Contact Settings
RESTAURANT_NAME="Pizza Hub"
RESTAURANT_PHONE="+92 300 1234567"
RESTAURANT_WHATSAPP="923001234567"
RESTAURANT_EMAIL="orders@pizzahub.com"

# Email Notifications (Nodemailer SMTP)
# Set your actual SMTP details to enable live email delivery.
# If left default/empty, notification logs will be saved to console & database safely without crashing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Pizza Hub <orders@pizzahub.com>"
ADMIN_ALERT_EMAIL="orders@pizzahub.com"

# WhatsApp Business / API Integration
# Direct WhatsApp links are automatically generated for customer and restaurant.
# Optional Twilio / Meta Cloud WhatsApp webhook credentials:
WHATSAPP_API_ENABLED=false
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
