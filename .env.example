# Pizza Hub Configuration Template
PORT=3000
NODE_ENV=production

# Admin Authentication
JWT_SECRET=change_this_to_a_random_secure_secret_in_production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Restaurant Contact Settings
RESTAURANT_NAME="Pizza Hub"
RESTAURANT_PHONE="+92 300 1234567"
RESTAURANT_WHATSAPP="923001234567"
RESTAURANT_EMAIL="orders@pizzahub.com"

# Email Notifications (SMTP / Gmail / SendGrid / Amazon SES)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="user@example.com"
SMTP_PASS="your-password"
SMTP_FROM="Pizza Hub <orders@example.com>"
ADMIN_ALERT_EMAIL="restaurant-owner@example.com"

# WhatsApp Business Integration
WHATSAPP_API_ENABLED=false
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
